@page "/"
@using XmppDotNet
@using System.Xml.Linq
@using System.Reactive.Linq
@implements IDisposable
@inject XmppClient XmppService
@inject NavigationManager NavManager
@inject chat.Session.UserSession UserSession
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@rendermode InteractiveServer

<div class="container flex justify-center items-center h-full">
    <div class="row justify-content-center w-full transform -translate-y-8">
        <div class="col-md-5">
            <form @onsubmit="ProsesLogin" @onsubmit:preventDefault class="card shadow p-4">
                <h3 class="text-center mb-4">Login Openfire Chat</h3>

                @if (!string.IsNullOrEmpty(PesanError))
                {
                    <div class="alert alert-danger">@PesanError</div>
                }

                @if (!string.IsNullOrEmpty(PesanSukses))
                {
                    <div class="alert alert-success">@PesanSukses</div>
                }

                <div class="mb-3">
                    <label class="form-label">Username / JID (Contoh: budi@@domain.Budi)</label>
                    <input type="text" pattern="^[^\s@@]+@@[^\s@@]+$" class="form-control" @bind="InputJid" placeholder="budi@@openfire" disabled="@SedangLoading" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" class="form-control" @bind="InputPassword" placeholder="******" disabled="@SedangLoading" />
                </div>

                <button class="btn btn-primary w-100" type="submit" disabled="@SedangLoading">
                    @if (SedangLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span> <span>Menghubungkan... Status: @StatusSekarang</span>
                    }
                    else
                    {
                        <span>Masuk Chat</span>
                    }
                </button>
            </form>
        </div>
    </div>
</div>

@code {
    private string InputJid = "";
    private string InputPassword = "";
    private string PesanError = "";
    private string PesanSukses = "";
    private bool SedangLoading = false;
    private string StatusSekarang = "";
    private IDisposable? _subState;

    private async Task ProsesLogin()
    {
        if (string.IsNullOrEmpty(InputJid) || string.IsNullOrEmpty(InputPassword))
        {
            PesanError = "Username dan Password tidak boleh kosong!";
            return;
        }

        PesanError = "";
        SedangLoading = true;

        _subState?.Dispose();
        _subState = null;

        try
        {
            XmppService.Jid = InputJid.Trim();
            XmppService.Password = InputPassword;

            _subState = XmppService.StateChanged.Subscribe(async state =>
            {
                StatusSekarang = state.ToString();
                await InvokeAsync(StateHasChanged);

                if (state == SessionState.Binded)
                {
                    PesanError = string.Empty;
                    PesanSukses = "Login Berhasil";
                    SedangLoading = false;
                    await InvokeAsync(StateHasChanged);
                    UserSession.Jid = InputJid.Trim();
                    UserSession.Password = InputPassword;

                    try
                    {
                        await KirimPresenceOnline();
                    }
                    catch (Exception exPres)
                    {
                        PesanError = $"Gagal kirim status online: {exPres.Message}";
                        Console.WriteLine($"Gagal kirim status online: {exPres.Message}");
                    }

                    await InvokeAsync(StateHasChanged);

                    await CariSemuaKontak();

                    await Task.Delay(Convert.ToInt32(Config["WebKitX:RedirectDelay"]));

                    await InvokeAsync(() =>
                    {
                        NavManager.NavigateTo("/chatview");
                    });
                }
                else if (state == SessionState.Authenticating)
                {
                    SedangLoading = true;
                    PesanError = "";
                    PesanSukses = "Silahkan Tunggu";
                    Console.WriteLine("Pesannya Connecting: " + PesanSukses);
                    await InvokeAsync(StateHasChanged);
                }
            });

            await XmppService.ConnectAsync();
        }
        catch (Exception ex)
        {
            PesanSukses = "";
            PesanError = "Gagal terhubung. Periksa kembali kredensial atau koneksi server Openfire Anda. Pastikan Jid berformat 'username@domain' dan password sudah benar.";
            SedangLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task KirimPresenceOnline()
    {
        var presenceElement = new XmppDotNet.Xml.XmppXElement("presence");
        var priorityElement = new XmppDotNet.Xml.XmppXElement("priority") { Value = "1" };
        var showElement = new XmppDotNet.Xml.XmppXElement("show") { Value = "chat" };
        presenceElement.Add(priorityElement);
        presenceElement.Add(showElement);
        await XmppService.SendAsync(presenceElement);
    }

    private async Task CariSemuaKontak()
    {
        try
        {
            var iqRequest = new XmppDotNet.Xmpp.Client.Iq
            {
                Type = XmppDotNet.Xmpp.IqType.Get,
                Id = $"roster_{Guid.NewGuid().ToString()[..8]}"
            };

            System.Xml.Linq.XNamespace rosterNs = "jabber:iq:roster";
            var queryElement = new XmppDotNet.Xml.XmppXElement(rosterNs + "query");
            iqRequest.Add(queryElement);

            var responsed = await XmppService.SendIqAsync(iqRequest);

            if (responsed.Type == XmppDotNet.Xmpp.IqType.Error)
            {
                Console.WriteLine("Gagal mengambil roster dari server.");
                return;
            }

            var queryRespon = responsed.Element(rosterNs + "query");

            if (queryRespon != null)
            {
                UserSession.Contacts = new Dictionary<string, string>();
                UserSession.ContactsName = new List<string>();
                var items = queryRespon.Elements(rosterNs + "item");

                foreach (var item in items)
                {
                    string userJid = item.Attribute("jid")?.Value!;
                    string username = item.Attribute("name")?.Value ?? userJid!;

                    if (!string.IsNullOrEmpty(userJid))
                    {
                        UserSession.Contacts[userJid] = username;
                        UserSession.ContactsName.Add(username);
                    }
                }
            }
        }
        catch (Exception e)
        {
            Console.WriteLine($"Terjadi error saat ambil roster: {e.Message}");
        }
    }



    public void Dispose()
    {
        _subState?.Dispose();
    }
}