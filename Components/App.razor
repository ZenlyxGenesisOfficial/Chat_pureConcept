<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["chat.styles.css"]" />
    <link rel="stylesheet" href="@Assets["tailwind-output.css"]" />
<script defer src="https://cdn.jsdelivr.net/npm/@@tailwindplus/elements@1" type="module"></script>

    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

<script>
    window.scrollToBottom = (elementId, ignorable = false) => {
        const el = document.getElementById(elementId);
        if (el) {
            console.log(el.scrollHeight-el.scrollTop-el.clientHeight);
            if (ignorable){
                if ((el.scrollHeight-el.scrollTop-el.clientHeight) <= 24){
                    el.scrollTop = el.scrollHeight - el.clientHeight;
                }
            }else{
                el.scrollTop = el.scrollHeight - el.clientHeight;
            }
        }
    };

    window.visibilityHelper = {
        _handler: null,

        register: function (dotnetRef){
            this.unregister();
            this._handler = () => {
                var hidden = document.visibilityState === 'hidden';
                dotnetRef.invokeMethodAsync(
                    'OnVisibilityChanged',
                    hidden ? 'away' : 'chat',
                    hidden ? 'Not On The Tab' : "Online"
                ).catch( (e) => {
                    console.log(e);
                });
            }
            document.addEventListener('visibilitychange',this._handler);
        },

        unregister: () => {
            if (!this._handler) return;
            document.removeEventListener('visibilitychange', this._handler);
            this._handler = null;
        }
    }
</script>

</html>
