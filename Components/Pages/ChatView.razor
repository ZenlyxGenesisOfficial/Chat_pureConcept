@page "/chatview"
@using chat.Session
@using System.Linq
@using System.Xml.Linq
@using System.Text.Json
@using System.Reactive.Linq
@using System.Reactive.Disposables
@using XmppDotNet
@using XmppDotNet.Xmpp
@using XmppDotNet.Xmpp.Client;
@implements IDisposable
@inject chat.Session.UserSession UsrSsn
@inject NavigationManager NavManager
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject IJSRuntime JS
@rendermode InteractiveServer

<h3>Aplikasi Kolaborasi Chat - Internet Hosting</h3>

<div class="alert alert-success">
    <strong>Status Jaringan:</strong> @UsrSsn.IsConnected
    <strong>As: </strong> @UsrSsn.Jid.Split('@')[0]
</div>

<div class="flex flex-row gap-4 w-full gap-3 h-[400px]">
    <div class="flex flex-col grow-[1] basis-0 gap-4">
        <div class="card p-3 self-start flex flex-1">
            <h5>Semua Kontak</h5>
            <div class="mb-3">
                <label class="form-label">Masukkan JID Teman (Manual):</label>
                <div class="input-group">
                    <input type="text" class="form-control" @bind="@TargetJidInput" @oninput="WritingJid" placeholder="tanpa '@@openfire'" />
                    <button class="btn btn-primary" @onclick="ClearOrConnect">
                        @(BtnClearType ? "Clear" : "Connect")
                    </button>
                </div>
            </div>
            <div>
                <label class="form-label">Daftar JID Teman:</label>
            </div>
            <div class="flex-1 max-h-[285px] self-start shrink-0 overflow-y-scroll scrollbar-hide border border-black rounded-md p-2 w-full">
                @foreach (var name in ContactsList)
                {

                    var jid = UsrSsn.Contacts.TryGetValue(name, out var j) ? j : name;
                    var state = UsrSsn.GetState(jid).FirstOrDefault().Key;

                    var bg = state switch
                    {
                        "Online" => "bg-emerald-700/80",
                        "away" => "bg-yellow-500/80",
                        "Offline" => "bg-neutral-200",
                        _ => "bg-rose-600/80"
                    };

                    var border = state switch
                    {
                        "Online" => "border-white !text-white/70",
                        "away" => "border-black !text-black/70",
                        "Offline" => "!border-rose-600/80",
                        _ => "border-white !text-white/70"
                    };

                    <div class="text-muted @bg mb-1 w-full p-1">
                        <button class="pl-1 box-border border @border w-full text-start" @onclick='() => ChooseTarget(name)'>
                            @name <span>[@state]</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!--Chat Box/Container-->
    <div class="grow-[3] basis-0 h-full">
        <div class="card p-3 flex flex-col h-full">
            <h5>Chat/:> @(string.IsNullOrEmpty(SelectedTargetJid) ? "" : SelectedTargetJid) [@(TargetIsOnline ? "Online" : "Offline")@(!string.IsNullOrEmpty(TargetShowStatus)?$" || {TargetShowStatus}":"")]</h5>

            <div id="ChatPopUp" class="border p-3 bg-light mb-3 grow" style="height: 375px; overflow-y: auto;">
                @if (ChatList.Count == 0)
                {
                    <div class="text-muted text-center pt-5">Belum ada percakapan...</div>
                }
                @foreach (var chat in ChatList)
                {
                    <div class="flex @(chat.IsMine ? "justify-end" : "justify-start")">
                        <div class="mb-2 max-w-[560px] flex flex-col @(chat.IsMine ? "items-end" : "items-start")">
                            <span class="badge size-fit @(chat.IsMine ? "bg-primary" : "bg-secondary")">
                                @(chat.IsMine ? "Saya" : chat.Name)
                            </span>
                            <small class="text-muted)">@chat.Time</small>
                            <p class="p-2 rounded bg-white min-w-[80px] size-fit border shadow-sm @(chat.IsMine ? "text-end" : "  text-start")">@chat.Text</p>
                        </div>
                    </div>
                }
            </div>

            <div class="input-group">
                <input type="text" class="form-control" placeholder="Ketik pesan di sini..."
                       @bind="ChatInputText" @onkeyup="HandleKeyDown" disabled="@string.IsNullOrEmpty(SelectedTargetJid)" />
                <button class="btn btn-primary" @onclick="SendMsg" disabled="@string.IsNullOrEmpty(SelectedTargetJid)">@(TargetIsOnline ? "Kirim" : "Chat-Off")</button>
            </div>
        </div>
    </div>
</div>

@code {
    private string SelectedTargetJid = "";
    private string ChatInputText = "";
    private string TargetJidInput = string.Empty;
    private string TargetShowStatus = string.Empty;
    private bool TargetIsOnline = false;
    private bool BtnClearType = false;

    public List<string> ContactsList => UsrSsn.ContactsName?.Where(x =>
    {
        return (x.ToLower().Contains(TargetJidInput.ToLower())) ||
        (UsrSsn.Contacts!.FirstOrDefault(y => y.Key == x).Value.ToLower().Contains(TargetJidInput.ToLower())) ||
        (TargetJidInput == "");
    }).OrderBy(x =>
    {
        string state = UsrSsn.GetState(UsrSsn.Contacts[x]!).FirstOrDefault().Key;
        return state switch
        {
            "Online" => 1,
            "away" => 2,
            "dnd" => 3,
            "Offline" => 5,
            _ => 4
        };
    })
    .ThenBy(x => x, StringComparer.OrdinalIgnoreCase)
    .ToList<String>() ?? new List<string>();

    private List<ChatModel> ChatList = new();

    private readonly CompositeDisposable _disposables = new CompositeDisposable();
    // private IDisposable? _presenceListener;

    protected override async void OnInitialized()
    {
        if (UsrSsn.IsConnected)
        {
            Console.WriteLine("Verifikasi berhasil");
            Console.WriteLine("Jid: " + UsrSsn.Jid);
            Console.WriteLine("Password: " + UsrSsn._password);
        }
        else
        {
            Console.WriteLine("gagal king");
            Console.WriteLine("Jid: " + UsrSsn.Jid);
            Console.WriteLine("Password: " + UsrSsn._password);
            NavManager.NavigateTo("/");
            return;
        }

        UsrSsn.OnChanged += Refresh;
    }

    private async void WritingJid(ChangeEventArgs e)
    {
        TargetJidInput = e.Value?.ToString() ?? "";
        BtnClearType = false;
    }

    private string FindJid(string dotFullName) => UsrSsn.Contacts.FirstOrDefault(x => x.Value.Contains(dotFullName)).Value;

    private async void RefreshTarget(bool ignore = true)
    {
        var contact = UsrSsn.GetState(FindJid(SelectedTargetJid)).FirstOrDefault();
        TargetIsOnline = contact.Key != "Offline";
        TargetShowStatus = contact.Value!="Online"?contact.Value??contact.Key:"";
        ChatList = await UsrSsn.Load(SelectedTargetJid);
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("scrollToBottom", "ChatPopUp", ignore);
    }

    private async void ClearOrConnect()
    {
        if (BtnClearType)
        {
            TargetJidInput = "";
            BtnClearType = false;
        }
        else
        {
            SelectedTargetJid = TargetJidInput;
            BtnClearType = true;
            RefreshTarget(false);
        }
    }

    private async void ChooseTarget(string Name)
    {
        SelectedTargetJid = UsrSsn.Contacts?[Name].Split("@")[0] ?? "";
        BtnClearType = true;
        RefreshTarget(false);
    }

    private async void SendMsg()
    {
        if (string.IsNullOrEmpty(ChatInputText) || string.IsNullOrEmpty(ChatInputText)) return;
        var text = ChatInputText;
        ChatInputText = "";
        await UsrSsn.SendAsync(FindJid(SelectedTargetJid), text);
        RefreshTarget(false);
    }

    private async void Refresh()
    {
        RefreshTarget();
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SendMsg();
        }
    }

    public void Dispose()
    {
        _disposables.Dispose();
    }
}
