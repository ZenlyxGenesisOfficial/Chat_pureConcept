@inject Session.UserSession UsrSsn

<div class="drpdwn-sb @Class" tabindex="0">
    <button class="dropdown-button dropdown-toggle"></button>
    <div class="dropdown-menu drpdwn-sm" tabindex="-1">
        <input class="drpdwn-sm form-control form-control-sm" placeholder="@PlaceHolder" @bind="searchKey" @onclick:stopPropagation="true" @bind:event="oninput" />
        <div>
            @foreach (var name in ContactsList)
            {
                <button class="flex w-full items-center gap-2 border-b px-3 py-2 text-left hover:bg-gray-100" @onclick:stopPropagation="true">
                    <span>@name</span>
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string PlaceHolder { get; set; } = "Type to search...";
    [Parameter] public List<string> Contacts { get; set; } = new();
    private IEnumerable<string> ContactsList
    {
        get
        {
            var q = (UsrSsn.ContactsName ?? new List<string>()).AsEnumerable();
            
            var s = searchKey.Trim();

            if (!string.IsNullOrWhiteSpace(searchKey))
            {
                q = q.Where(n =>
                    (
                        n.Contains(s, StringComparison.OrdinalIgnoreCase) 
                        || (
                            UsrSsn.Contacts.TryGetValue(n, out var jid)
                            && jid.Contains(s, StringComparison.OrdinalIgnoreCase)
                            )
                    )
                );
            }

            return !string.IsNullOrWhiteSpace(s)
                ? q.OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                : new List<string>();
        }
    }
    private string searchKey = string.Empty;
}