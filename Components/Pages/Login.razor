@page "/"
@using XmppDotNet
@implements IDisposable
@inject chat.Session.UserSession UsrSsn
@inject NavigationManager NavManager
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@rendermode InteractiveServer

<div class="container flex justify-center items-center h-full">
    <div class="row justify-content-center w-full transform -translate-y-8">
        <div class="col-md-5">
            <form @onsubmit="LoginProcess" @onsubmit:preventDefault class="card shadow p-4">
                <h3 class="text-center mb-4">Login Openfire Chat</h3>

                @if (!string.IsNullOrEmpty(StatusMsg))
                {
                    <div class="alert @(IsError ? "alert-danger" : "alert-success")">@StatusMsg</div>
                }

                <div class="mb-3">
                    <label class="form-label">JID (Contoh: budi@@sub.domain.id)</label>
                    <input type="text" pattern="^[^\s@@]+@@[^\s@@]+$" class="form-control" @bind="InputJid" placeholder="budi@@openfire" disabled="@OnLoad" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" class="form-control" @bind="InputPassword" placeholder="******" disabled="@OnLoad" />
                </div>

                <button class="btn btn-primary w-100" type="submit" disabled="@OnLoad">
                    @if (OnLoad)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }

                    <span>@(OnLoad ? $"{CurState}..." : "Masuk Chat")</span>
                </button>
            </form>
        </div>
    </div>
</div>

@code {
    private string InputJid = "";
    private string InputPassword = "";
    private string StatusMsg = "";
    private string CurState = "";
    private bool IsError = false;
    private bool OnLoad = false;
    private TaskCompletionSource<bool>? _source;

    protected override void OnInitialized()
    {
        UsrSsn.OnChanged += Refresh;
    }

    private async Task LoginProcess()
    {
        if (!OnLoad)
        {
            _source = new TaskCompletionSource<bool>();
            await UsrSsn.DisconnectAsync();
            CurState = "Connecting";
            OnLoad = true;
            await UsrSsn.ConnectAsync(InputJid, InputPassword);
            await _source.Task;
            if (UsrSsn.IsConnected)
            {
                IsError = false;
                StatusMsg = "Login Success";
                CurState = "Redirecting";
                await Task.Delay(Convert.ToInt32(Config["WebKitX:RedirectDelay"]));
                NavManager.NavigateTo("/chatview");
            }
            else
            {
                IsError = true;
                StatusMsg = "There is wrong credential, Please make sure Jid and Password correctly!";
                OnLoad = false;
            }
        }
    }

    private async void Refresh()
    {
        var stack = new System.Diagnostics.StackTrace(true);
        InvokeAsync(StateHasChanged);
        _source?.TrySetResult(true);
    }

    public void Dispose()
    {
        UsrSsn.OnChanged -= Refresh;
    }
}