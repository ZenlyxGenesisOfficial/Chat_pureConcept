@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager NM
@inject chat.Session.UserSession UsrSsn

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <BootstrapBlazorRoot>
        <main class="h-screen">
            <article class="content px-4 h-full">
                    @Body
            </article>
        </main>
    </BootstrapBlazorRoot>
    @{
        var path = NM.ToBaseRelativePath(NM.Uri);
    }
    @if (path != "chatview"){
    <ChatWidget />
    }
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code{
    private DotNetObjectReference<MainLayout>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("visibilityHelper.register", _selfRef);
    }

    [JSInvokable]
    public async Task OnVisibilityChanged(string show, string status="")
    {
        try
        {
            await UsrSsn.SetPresence(show, status);
        }
        catch (Exception ex){ System.Console.WriteLine(ex); }
    }
}