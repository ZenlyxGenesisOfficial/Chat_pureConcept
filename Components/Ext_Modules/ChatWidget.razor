@using chat.Session
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.RegularExpressions
@using System.Net
@implements IAsyncDisposable
@inject chat.Session.UserSession UsrSsn
@inject IJSRuntime JS
@rendermode InteractiveServer

@if (UsrSsn.IsConnected)
{
    @if (isOpen)
    {
        <div class="fixed bottom-24 right-5 z-50 flex h-[420px] w-80 flex-col rounded-xl bg-white shadow-2xl">

            <!-- Header or Nav Menu -->
            <div class="flex items-center justify-between rounded-t-xl bg-blue-600 px-3 py-2 text-white mb-1 gap-2">
                @if (selectedName == null)
                {
                    <span>Chat</span>
                }
                else
                {
                    <div class="flex items-center gap-2 flex-1 min-w-0">
                        <button class="shrink-0" @onclick="BackToList">←</button>
                        <div class="flex-1 min-w-0 leading-tight">
                            <div>@selectedName</div>
                            <div class="flex items-center justify-between gap-2">
                                <div class="text-xs text-blue-100 shrink-0">@StatusLine</div>
                                <SearchDropDown class="border bg-white/50 flex-1 min-w-0 w-full" PlaceHolder="Search another user? " />
                            </div>
                        </div>
                    </div>
                }
                <button class="!p-0 shrink-0" @onclick="ToggleChat">✕</button>
            </div>

            @if (selectedName == null)
            {
                <div class="border-b p-2">
                    <div class="relative">
                        <input type="text" class="w-full rounded border py-1 pl-2 pr-8"
                               placeholder="Cari nama / JID..."
                               @bind="searchText" @bind:event="oninput" />

                        @if (!string.IsNullOrEmpty(searchText))
                        {
                            <button class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
                                    @onclick="ClearSearch">
                                ✕
                            </button>
                        }
                    </div>
                </div>

                var list = Contacts.ToList();
                <div id="ContactList" class="min-h-0 flex-1 overflow-y-auto">
                    @if (list.Count == 0)
                    {
                        <p class="mt-10 text-center text-gray-400">Kontak tidak ditemukan</p>
                    }
                    @foreach (var name in list)
                    {
                        <button class="flex w-full items-center gap-2 border-b px-3 py-2 text-left hover:bg-gray-100"
                                @onclick="() => OpenChat(name)">
                            <span class="size-3 rounded-full @DotColor(name)"></span>
                            <span>@name</span>
                        </button>
                    }
                </div>
                <div class="border-t p-2">
                    <label class="mb-1 block text-xs @(string.IsNullOrEmpty(CurrentPresenceStatus) ? "text-gray-500" : "")">Custom status: @(string.IsNullOrEmpty(CurrentPresenceStatus) ? "-- No Status --" : CurrentPresenceStatus)</label>
                    <div class="flex gap-2">
                        <input type="text" class="min-w-0 flex-1 rounded border px-2 py-1"
                               placeholder="e.g. In a meeting"
                               value="@UsrSsn.MyPresenceStatus"
                               @oninput="OnStatusInput" @onkeyup="StatusKey" />
                        @if (statusLoading)
                        {
                            <div class="w-[56px] flex justify-center items-center">
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            </div>
                        }
                        else
                        {
                            <button class="rounded bg-blue-600 px-3 text-white" @onclick="SetStatus">Set</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- Chat Section -->
                <div id="ChatView" class="min-h-0 flex-1 overflow-y-auto bg-gray-100 p-3">
                    @if (messages.Count == 0)
                    {
                        <p class="mt-10 text-center text-gray-400">Belum ada percakapan...</p>
                    }
                    @{
                        var lastDay = "";
                    }
                    @foreach (var msg in messages)
                    {
                        <div @key="msg.Id">
                            @{
                                var day = DayKey(msg.Time);
                                if (day != lastDay)
                                {
                                    <div class="my-2 flex justify-center">
                                        <span class="rounded-full bg-gray-200 px-3 py-0.5 text-xs text-gray-600">@DayLabel(day)</span>
                                    </div>
                                    lastDay = day;
                                }
                            }
                            <div class="mb-2 flex @(msg.IsMine ? "justify-end" : "justify-start")">
                                <div class="max-w-[75%] break-words rounded-lg px-3 py-1.5 @(msg.IsMine ? "bg-blue-600 text-white" : "border bg-white")">
                                    @if (IsImage(msg.Text))
                                    {
                                        <a href="@msg.Text" target="_blank">
                                            <img src="@msg.Text" loading="lazy" class="h-40 max-w-full rounded bg-gray-200 object-contain" />
                                        </a>
                                    }
                                    else if (IsUrl(msg.Text))
                                    {
                                        <a href="@msg.Text" target="_blank" class="break-all underline">@FileName(msg.Text)</a>
                                    }
                                    else
                                    {
                                        <div class="msgBubble whitespace-pre-wrap text-sm leading-relaxed">
                                            @Emot(msg.Text)
                                        </div>
                                    }
                                    <div class="mt-1 text-right text-[10px] leading-none @(msg.IsMine ? "text-blue-100" : "text-gray-400")"
                                         title="@msg.Time">
                                        @msg.Time.Split(" - ")[0]
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Descending Nav -->
                <div class="flex gap-2 border-t p-2">
                    <TextEditor @bind-Value="inputText" Class="EditorAbs min-w-0 flex flex-1 grow gap-1 justify-content-evenly" Height="60" OnClickButton="Send" />
                </div>
            }
        </div>
    }

    <button class="fixed bottom-5 right-5 z-50 size-14 !rounded-full bg-blue-600 text-2xl text-white shadow-lg"
            @onclick="ToggleChat">
        💬
    </button>
}

@code {
    public static IConfiguration Config = new ConfigurationBuilder()
        .AddUserSecrets<Program>()
        .Build();

    private bool isOpen = false;
    private string? selectedName = null;
    private string fullJid = "";
    private string inputText = "";
    private string searchText = "";
    private string CurrentPresenceStatus = string.Empty;
    private List<ChatModel> messages = new();

    // -- Scroll Position --
    private double savedScroll = 0;
    private bool restoreScroll = false;
    private double chatScrollCP = 0;
    private bool chatScroll = false;
    private bool chatScrollIgnore = false;
    private bool OpenChatBack = false;

    public void Apa(string a)
    {
        System.Console.WriteLine(a);
    }

    // -- Contact Filtering --
    private void ClearSearch() => searchText = "";

    private IEnumerable<string> Contacts
    {
        get
        {
            var q = (UsrSsn.ContactsName ?? new List<string>()).AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var s = searchText.Trim();
                q = q.Where(n =>
                    n.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (UsrSsn.Contacts.TryGetValue(n, out var jid) &&
                     jid.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }

            return q.OrderBy(n => StateOrder(StateOf(n)))
                    .ThenBy(n => n, StringComparer.OrdinalIgnoreCase);
        }
    }

    private string StatusLine
    {
        get
        {
            if (selectedName == null) return "";

            var contact = UsrSsn.GetState(fullJid).FirstOrDefault();
            var show = contact.Key ?? "Offline";
            var status = contact.Value;

            var showText = show switch
            {
                "xa" => "Extend Away",
                "dnd" => "Don't Disturb",
                "away" => "Away",
                _ => show
            };

            bool custom = !string.IsNullOrWhiteSpace(status)
                          && status != "Online"
                          && !status.Equals(show, StringComparison.OrdinalIgnoreCase);

            return custom ? $"{showText} - {status}" : showText;
        }
    }

    private static int StateOrder(string state) => state switch
    {
        "Online" => 1,
        "away" => 2,
        "dnd" => 4,
        "Offline" => 5,
        _ => 3
    };

    private string DotColor(string name) => StateOf(name) switch
    {
        "Online" => "bg-emerald-500",
        "away" => "bg-yellow-400",
        "xa" => "bg-amber-600",
        "dnd" => "bg-rose-600",
        _ => "bg-gray-300"
    };


    // -- Personal Chat Status --
    private string StateOf(string name) =>
        UsrSsn.GetState(UsrSsn.Contacts[name]).FirstOrDefault().Key ?? "Offline";


    // -- Status Custom --
    private bool statusLoading = false;
    private void OnStatusInput(ChangeEventArgs e) =>
        UsrSsn.MyPresenceStatus = e.Value?.ToString() ?? "";

    private async Task StatusKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SetStatus();
    }

    private async Task SetStatus()
    {
        statusLoading = true;
        await UsrSsn.SetPresence("chat", null);
        await Task.Delay(int.Parse(Config["WebKitX:RedirectDelay"]));
        CurrentPresenceStatus = UsrSsn.MyPresenceStatus;
        statusLoading = false;
    }

    // -- Contact Selection Mechanics --
    private async Task ToggleChat()
    {
        var isOpenCP = isOpen;
        if (isOpenCP)
        {
            chatScrollCP = await JS.InvokeAsync<double>("chatWidget.getScrollTop", "ChatView");
            isOpen = !isOpen;
        }
        else
        {
            try
            {
                chatScroll = true;
                OpenChatBack = true;
                isOpen = !isOpen;
            }
            catch (JSDisconnectedException) { }
        }
    }

    private async Task OpenChat(string name)
    {
        try
        {
            savedScroll = await JS.InvokeAsync<double>("chatWidget.getScrollTop", "ContactList");
        }
        catch (JSDisconnectedException) { }

        selectedName = name;
        chatScrollCP = 0;
        fullJid = UsrSsn.Contacts[name];
        await ChatRefreshtor(true, false);
    }

    private void BackToList()
    {
        selectedName = null;
        messages = new();
        restoreScroll = true;
    }

    // -- Rendering --
    protected override void OnInitialized()
    {
        UsrSsn.OnChanged += Refresh;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("visibilityHelper.register", _selfRef);

        if (restoreScroll)
        {
            restoreScroll = false;

            try
            {
                await JS.InvokeVoidAsync("chatWidget.setScrollTop", "ContactList", savedScroll);
            }
            catch (JSDisconnectedException) { }
        }

        if (isOpen && chatScroll)
        {
            chatScroll = false;
            if (OpenChatBack)
            {
                OpenChatBack = false;
                await JS.InvokeVoidAsync("chatWidget.setScrollTop", "ChatView", chatScrollCP);
            }
            else await JS.InvokeVoidAsync("scrollToBottom", "ChatView", chatScrollIgnore);
        }
    }

    private DotNetObjectReference<ChatWidget>? _selfRef;

    [JSInvokable]
    public async Task OnVisibilityChanged(string show, string status = "")
    {
        try
        {
            await UsrSsn.SetPresence(show, status);
        }
        catch (Exception ex) { System.Console.WriteLine(ex); }
    }

    private async Task ChatRefreshtor(bool cS = false, bool ignore = true)
    {
        messages = await UsrSsn.Load(fullJid.Split('@')[0]);
        chatScroll = cS;
        chatScrollIgnore = ignore;
        await InvokeAsync(StateHasChanged);
    }

    // -- Chat Input Sys --
    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Send();
    }

    private static string DayKey(string time) => time.Split(" - ").Last();

    private static string DayLabel(string dayKey)
    {
        var p = dayKey.Split('/');
        var d = new DateTime(int.Parse(p[2]), int.Parse(p[1]), int.Parse(p[0]));

        var diff = (DateTime.Today - d).Days;
        return diff == 0 ? "Hari Ini"
             : diff == 1 ? "Kemarin"
             : dayKey;
    }

    private static readonly Dictionary<string, string> Emots = new(StringComparer.OrdinalIgnoreCase)
    {
        { ">:o",     "😠" },
        { ";-)",     "😉" },
        { ":-[",     "😳" },
        { "?:|",     "🤨" },
        { "B-)",     "😎" },
        { ":'(",     "😢" },
        { "]:)",     "😈" },
        { ":-D",     "😃" },
        { ":-)",     "🙂" },
        { ":^0",     "😲" },
        { "(!)",     "⚠️" },
        { ":x",      "🤐" },
        { ";\\",     "😕" },
        { ":-(",     "🙁" },
        { ":|",      "😐" },
        { ":0",      "😮" },
        { ":-p",     "😛" },
        { "(i)",     "💡" },
        { "(-)",     "👎" },
        { "(+)",     "👍" },
        { "(heart)", "❤️" },
    };

    private static MarkupString Emot(string? text)
    {
        if (string.IsNullOrEmpty(text))
            return new MarkupString("");

        var hasil = string.Join(" ", text.Split(' ')
            .Select(w => Emots.TryGetValue(w, out var e) ? e : w));

        return new MarkupString(hasil);
    }

    private static bool IsUrl(string t) =>
        !t.Contains(' ') && (t.StartsWith("http://") || t.StartsWith("https://") || t.StartsWith("/uploads/"));

    private static bool IsImage(string t) =>
        IsUrl(t) && UserSession.AllowedExt.Any(x => t.Split('?')[0].EndsWith(x, StringComparison.OrdinalIgnoreCase));

    private static string FileName(string url) =>
        Uri.UnescapeDataString(url.Split('?')[0].Split('/').Last());

    private async Task Send()
    {
        System.Console.WriteLine($"ngirim nih : {inputText}");
        if (string.IsNullOrWhiteSpace(inputText) || selectedName == null) return;

        var teks = inputText;
        await UsrSsn.SendAsync(fullJid, teks);
        inputText = "";
        await ChatRefreshtor(true, false);
    }

    private async void Refresh()
    {
        try
        {
            if (selectedName != null)
            {
                await ChatRefreshtor();
            }
            else await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        UsrSsn.OnChanged -= Refresh;
        try
        {
            await JS.InvokeVoidAsync("visibilityHelper.unregister");
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        _selfRef?.Dispose();
    }
}